{
  "name": "Pallet Town: boots, movement, no N64 exception",
  "description": "Wait for opening title overlay to settle, measure idle animation, then drive Link forward and require the visual movement to exceed idle drift; also check for N64 exception screens.",
  "steps": [
    {
      "action": "wait",
      "seconds": 10
    },
    {
      "action": "assert_status"
    },
    {
      "action": "screenshot",
      "name": "idle_before"
    },
    {
      "action": "assert_visible",
      "image": "idle_before",
      "min_color_spread": 35
    },
    {
      "action": "assert_no_fault",
      "image": "idle_before"
    },
    {
      "action": "wait",
      "seconds": 1.5
    },
    {
      "action": "screenshot",
      "name": "idle_after"
    },
    {
      "action": "stick",
      "stick": "left",
      "x": 0,
      "y": -25000,
      "seconds": 1.5
    },
    {
      "action": "wait",
      "seconds": 0.35
    },
    {
      "action": "screenshot",
      "name": "after_walk"
    },
    {
      "action": "assert_visible",
      "image": "after_walk",
      "min_color_spread": 35
    },
    {
      "action": "assert_movement",
      "idle_before": "idle_before",
      "before": "idle_after",
      "after": "after_walk",
      "ratio": 1.8,
      "min_difference": 8
    },
    {
      "action": "assert_no_fault",
      "image": "after_walk"
    },
    {
      "action": "assert_status"
    }
  ]
}
